---
interface Props {
    class?: string;
    title: string;
    linkName: string;
    linkHref: string;
}

const { class: className, title, linkName, linkHref } = Astro.props;
---

<div
    class:list={["relative bg-primary text-primary-contrast rounded-2xl p-10 flex flex-col items-center gap-5", className]}
>
    <h3
        class="text-4xl text-transparent text-stroke-1 text-stroke-primary-contrast"
    >
        {title}
    </h3>

    <p
        class="text-4xl tracking-widest text-transparent text-stroke-1 text-stroke-primary-contrast"
    >
        +++
    </p>

    <slot />

    <a
        href={linkHref}
        target="_blank"
        rel="noopener"
        class="bg-primary-contrast text-primary py-2 px-4 rounded-lg"
        >{linkName}</a
    >
</div>
