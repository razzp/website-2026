---
import '../styles/global.css';

interface Props {
    title: string;
}

const { title } = Astro.props;

const navItems = new Map([
    ['Home Page', '/'],
    ['About Me', '/about'],
]);
---

<html lang="en">
    <head>
        <meta charset="utf-8">

        <link rel="icon" type="image/svg+xml" href="/favicon.svg">
        <link rel="icon" href="/favicon.ico">

        <meta name="viewport" content="width=device-width">
        <meta name="generator" content={Astro.generator}>

        <title>{title}</title>

        <script src="../scripts/layouts/DefaultLayout.ts"></script>
    </head>
    <body>
        <p class="mb-4">[Default Layout]</p>

        <nav class="mb-4">
            <ol class="flex gap-4 underline">
                {navItems.entries().map(([name, href]) => <li><a href={href} data-astro-prefetch data-link-swap>{name}</a></li>)}
            </ol>
        </nav>

        <div data-swap="app">
            <slot />
        </div>
    </body>
</html>
