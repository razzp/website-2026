---
import '../styles/global.css';
import '../styles/pages.css';

import { Font } from 'astro:assets';
import HandIcon from 'bootstrap-icons/icons/hand-index.svg';
import MouseIcon from 'bootstrap-icons/icons/mouse.svg';
import CloseIcon from 'bootstrap-icons/icons/x-circle-fill.svg';
import DuotoneFilter from '../components/DuotoneFilter.astro';
import { navigation, type PageMeta, socials } from '../lib/config';
import { getThemeVarsAsStyles } from '../scripts/utils';

interface Props {
    pageMeta: PageMeta;
}

const { pageMeta } = Astro.props;

const rootStyles = [
    ...getThemeVarsAsStyles(pageMeta.theme),
    `background-color:var(--theme-primary)`,
];
---

<html lang="en" style={rootStyles.join(';')}>
    <head>
        <meta charset="utf-8">

        <link rel="icon" type="image/svg+xml" href="/favicon.svg">
        <link rel="icon" href="/favicon.ico">

        <meta name="viewport" content="width=device-width,initial-scale=1.0">
        <meta name="generator" content={Astro.generator}>
        <meta name="theme-color" content={pageMeta.theme.primary}>

        <title>{pageMeta.metaTitle}</title>

        <Font cssVariable="--font-stack-sans-text" preload />

        <script
            type="application/json"
            id="page-meta"
            set:html={JSON.stringify(pageMeta)}
            is:inline
        />

        <script src="../scripts/layouts/DefaultLayout.ts"></script>
    </head>

    <body class="bg-primary">
        <dialog class="js-mob-nav-dialog c-mob-nav-dialog" closedby="any">
            <div class="js-dialog-inner flex flex-col pb-10 gap-10">
                <p
                    class="js-dialog-heading text-center pt-10 text-2xl text-primary-contrast"
                    >menu</p
                >

                <button
                    type="button"
                    class="js-fade js-mob-nav-close absolute top-0 right-0 text-xl text-center p-4 lowercase"
                >
                    <CloseIcon width={24} height={24} fill="currentColor" />
                </button>

                <ol class="flex flex-col items-center gap-4 lowercase text-xl">
                    {navigation.map(({ name, href }) => 
                        <li>
                            <a href={href} class="js-fade text-link" data-astro-prefetch data-link-swap>
                                {name}
                            </a>
                        </li>
                    )}
                </ol>

                <ol class="js-fade flex justify-center gap-8">
                    {socials.map(({ icon: Icon, name, href }) => 
                        <li>
                            <a href={href} target="_blank" rel="noopener" aria-label={name}>
                                <Icon width={36} height={36} fill="currentColor" class="icon-link" />
                            </a>
                        </li>
                    )}
                </ol>
            </div>
        </dialog>

        <nav class="c-main-nav js-main-nav">
            <ol>
                {navigation.map(({ name, href }) => 
                    <li class="hidden lg:list-item">
                        <a href={href} class="text-link" data-astro-prefetch data-link-swap>
                            {name}
                        </a>
                    </li>
                )}

                <li class="lg:hidden">
                    <button
                        type="button"
                        class="js-mob-nav-open text-link px-6 py-2"
                        >menu</button
                    >
                </li>

                {socials.map(({ icon: Icon, name, href }) => 
                    <li class="hidden lg:list-item">
                        <a href={href} target="_blank" rel="noopener" aria-label={name}>
                            <Icon width={24} height={24} fill="currentColor" class="icon-link" />
                        </a>
                    </li>
                )}
            </ol>
        </nav>

        <div
            class="relative z-10 grid min-h-svh in-[.-show-content]:mb-(--inset-y)"
        >
            <!-- Background -->

            <div
                class="[grid-area:1/1] px-(--inset-x) py-(--inset-y) pb-0 select-none pointer-events-none overflow-clip"
                aria-hidden="true"
            >
                <div
                    class="js-hero-background h-[calc(100svh-var(--inset-y))]"
                ></div>
            </div>

            <!-- Foreground -->

            <main
                class="c-main-content [grid-area:1/1] px-(--inset-x) py-(--inset-y) pb-0 bg-primary-contrast text-primary overflow-clip"
            >
                <header
                    class="js-main-header @container h-[calc(100svh-var(--inset-y))] relative flex flex-col justify-center gap-14 lg:gap-20"
                >
                    <div
                        class="js-hero-placeholder h-[clamp(50px,25cqi,250px)]"
                    ></div>

                    <div
                        class="js-hero-foreground absolute inset-0"
                        aria-hidden="true"
                    ></div>

                    <div>
                        <h1 class="js-hero-heading sr-only">
                            {pageMeta.heading}
                        </h1>

                        <p
                            class="js-hero-strapline px-2 text-center rfs-3xl-7xl mb-10 leading-tight text-balance"
                        >
                            {pageMeta.strapline}
                        </p>
                    </div>

                    <div
                        class="absolute left-0 right-0 bottom-5 flex justify-center"
                    >
                        <HandIcon
                            width={40}
                            height={40}
                            fill="currentColor"
                            class="lg:hidden text-current animate-float not-in-[.-show-nav.-show-mouse-hint]:opacity-0 transition-opacity duration-1000"
                            aria-hidden="true"
                        />

                        <MouseIcon
                            width={46}
                            height={46}
                            fill="currentColor"
                            class="hidden lg:inline text-current animate-float not-in-[.-show-nav.-show-mouse-hint]:opacity-0 transition-opacity duration-1000"
                            aria-hidden="true"
                        />
                    </div>
                </header>

                <div class="not-in-[.-show-content]:hidden">
                    <div data-swap="content">
                        <DuotoneFilter
                            colourStart={pageMeta.theme.primaryContrast}
                            colourEnd={pageMeta.theme.primary}
                        />

                        <slot />
                    </div>

                    <canvas class="js-footer-pixels w-full bg-primary"></canvas>
                </div>
            </main>

            <footer
                class="not-in-[.-show-content]:hidden px-(--inset-x) mt-(--inset-y) flex flex-col items-center gap-4 text-primary-contrast"
            >
                <nav>
                    <ol class="flex items-center gap-4 lowercase">
                        {navigation.map(({ name, href }) => 
                            <li>
                                <a href={href} class="hover:underline decoration-wavy underline-offset-2 decoration-from-font" data-astro-prefetch data-link-swap>
                                    {name}
                                </a>
                            </li>
                        )}
                    </ol>
                </nav>

                <nav>
                    <ol class="flex items-center gap-4">
                        {socials.map(({ icon: Icon, name, href }) => 
                            <li>
                                <a href={href} target="_blank" rel="noopener" aria-label={name}>
                                    <Icon width={16} height={16} fill="currentColor" />
                                </a>
                            </li>
                        )}
                    </ol>
                </nav>
            </footer>
        </div>
    </body>
</html>
