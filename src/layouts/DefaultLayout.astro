---
import '../styles/global.css';

import { Font } from 'astro:assets';
import MouseIcon from 'bootstrap-icons/icons/mouse.svg';
import DuotoneFilter from '../components/DuotoneFilter.astro';
import { navigation, type PageMeta, socials } from '../lib/config';
import { getThemeVarsAsStyles } from '../scripts/utils';

interface Props {
    pageMeta: PageMeta;
}

const { pageMeta } = Astro.props;

const rootStyles = [
    ...getThemeVarsAsStyles(pageMeta.theme),
    `background-color:var(--theme-primary)`,
];
---

<html lang="en" style={rootStyles.join(';')} class="scrollbar-gutter-stable">
    <head>
        <meta charset="utf-8">

        <link rel="icon" type="image/svg+xml" href="/favicon.svg">
        <link rel="icon" href="/favicon.ico">

        <meta name="viewport" content="width=device-width,initial-scale=1.0">
        <meta name="generator" content={Astro.generator}>
        <meta name="theme-color" content={pageMeta.theme.primary}>

        <title>{pageMeta.title}</title>

        <Font cssVariable="--font-stack-sans-text" preload />

        <script
            type="application/json"
            id="page-meta"
            set:html={JSON.stringify(pageMeta)}
            is:inline
        />

        <script src="../scripts/layouts/DefaultLayout.ts"></script>
    </head>

    <body class="bg-primary">
        <nav id="main-nav">
            <ol class="transition-colors-default">
                {navigation.map(({ name, href }) => 
                    <li>
                        <a href={href} class="text-link" data-astro-prefetch data-link-swap>
                            {name}
                        </a>
                    </li>
                )}

                {socials.map(({ icon: Icon, name, href }) => 
                    <li>
                        <a href={href} target="_blank" rel="noopener" aria-label={name}>
                            <Icon width={24} height={24} fill="currentColor" class="icon-link" />
                        </a>
                    </li>
                )}
            </ol>
        </nav>

        <div
            class="relative z-10 grid min-h-dvh in-[.-show-content]:mb-(--inset)"
        >
            <!-- Background -->

            <div
                class="[grid-area:1/1] p-(--inset) pb-0 select-none pointer-events-none overflow-clip"
                aria-hidden="true"
            >
                <div
                    id="hero-background"
                    class="h-[calc(100dvh-var(--inset))]"
                ></div>
            </div>

            <!-- Foreground -->

            <main
                class="[grid-area:1/1] p-(--inset) pb-0 bg-(--theme-content-background) text-(--theme-content-text) overflow-clip"
            >
                <header
                    id="main-header"
                    class="h-[calc(100dvh-var(--inset))] grid grid-rows-[1fr_280px_auto_1fr] gap-12"
                >
                    <div id="hero-placeholder" class="row-2 col-1"></div>

                    <div
                        id="hero-foreground"
                        class="row-[1/5] col-1"
                        aria-hidden="true"
                    ></div>

                    <div class="row-3 col-1">
                        <h1 id="hero-heading" class="sr-only">
                            {pageMeta.heading}
                        </h1>

                        <p
                            id="hero-strapline"
                            class="text-center text-7xl leading-tight text-balance"
                        >
                            {pageMeta.strapline}
                        </p>
                    </div>

                    <MouseIcon
                        width={46}
                        height={46}
                        fill="currentColor"
                        class="row-4 col-1 self-center justify-self-center text-current animate-float not-in-[.-show-nav.-show-mouse-hint]:opacity-0 transition-opacity duration-1000"
                        aria-hidden="true"
                    />
                </header>

                <div class="not-in-[.-show-content]:hidden">
                    <div data-swap="content">
                        <DuotoneFilter
                            colourStart={pageMeta.theme.primaryContrast}
                            colourEnd={pageMeta.theme.primary}
                        />

                        <slot />
                    </div>

                    <canvas
                        id="footer-pixels"
                        class="w-full bg-primary"
                    ></canvas>
                </div>
            </main>

            <footer
                class="not-in-[.-show-content]:hidden px-(--inset) mt-(--inset) flex flex-col items-center gap-4 text-primary-contrast"
            >
                <nav>
                    <ol class="flex items-center gap-4 lowercase">
                        {navigation.map(({ name, href }) => 
                            <li>
                                <a href={href} class="hover:underline decoration-wavy underline-offset-2 decoration-from-font">
                                    {name}
                                </a>
                            </li>
                        )}
                    </ol>
                </nav>

                <nav>
                    <ol class="flex items-center gap-4">
                        {socials.map(({ icon: Icon, name, href }) => 
                            <li>
                                <a href={href} target="_blank" rel="noopener" aria-label={name}>
                                    <Icon width={16} height={16} fill="currentColor" />
                                </a>
                            </li>
                        )}
                    </ol>
                </nav>
            </footer>
        </div>
    </body>
</html>
