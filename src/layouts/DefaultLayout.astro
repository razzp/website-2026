---
import '../styles/global.css';

import { Font } from 'astro:assets';
import MouseIcon from 'bootstrap-icons/icons/mouse.svg';
import { navigation, type Page, socials } from '../lib/config';

interface Props {
    page: Page;
}

const { page } = Astro.props;

const themeVars = Object.entries(page.theme)
    .map(
        ([key, value]) =>
            `--theme-${key.replace(/[A-Z]/g, (m) => `-${m.toLowerCase()}`)}: ${value}`,
    )
    .join('; ');
---

<html
    lang="en"
    style={themeVars}
    class="scrollbar-gutter-stable xtransition-colors-default"
>
    <head>
        <meta charset="utf-8">

        <link rel="icon" type="image/svg+xml" href="/favicon.svg">
        <link rel="icon" href="/favicon.ico">

        <meta name="viewport" content="width=device-width">
        <meta name="generator" content={Astro.generator}>
        <meta name="theme-color" content={page.theme.primary}>

        <title>{page.title}</title>

        <Font cssVariable="--font-stack-sans-text" preload />

        <style>
            @property --theme-primary {
                syntax: '<color>';
                inherits: true;
                initial-value: transparent;
            }

            :root {
                --inset: 100px;
                --inset-half: calc(var(--inset) / 2);
            }

            main {
                --inset-top: 100%;
                --stretch: 0px;
                --top: calc(var(--inset-top) - var(--stretch));
                --right: calc(100% - var(--inset));

                clip-path: shape(
                    from var(--inset) var(--top),
                    curve to var(--right) var(--top) with 50%
                        calc(var(--inset-top) - (var(--stretch) * 2)),
                    curve to var(--right) 100% with
                        calc(100% - var(--inset) - var(--stretch)),
                    line to var(--inset) 100%,
                    curve to var(--inset) var(--top) with
                        calc(var(--inset) + var(--stretch)),
                    close
                );
            }
        </style>

        <script
            type="application/json"
            id="config"
            set:html={JSON.stringify(page)}
            is:inline
        />

        <!--<script src="../scripts/layouts/DefaultLayout.ts"></script> -->

        <script>
            const [{ init }] = await Promise.all([
                import('../scripts/layouts/DefaultLayout'),
                document.fonts.ready,
            ]);

            await init();
        </script>
    </head>

    <body class="bg-primary">
        <nav
            class="fixed z-20 inset-x-0 top-(--inset-half) flex justify-center in-[.-show-nav]:opacity-100 in-[.-show-nav]:translate-y-[-50%] not-in-[.-show-nav]:-translate-y-full not-in-[.-show-nav]:opacity-0 not-in-[.-show-nav]:pointer-events-none transition-all duration-700 ease-in-out-expo"
        >
            <ol
                class="flex items-center gap-8 px-8 p-4 bg-primary-translucent hover:[--alpha:100%] backdrop-blur-xl transition-colors-default rounded-full lowercase text-3xl"
            >
                {navigation.map(({ name, href }) => 
                    <li>
                        <a href={href} class="text-primary-contrast hover:underline decoration-wavy underline-offset-4 decoration-from-font" data-astro-prefetch data-link-swap>
                            {name}
                        </a>
                    </li>
                )}

                {socials.map(({ icon: Icon, name, href }) => 
                    <li>
                        <a href={href} target="_blank" rel="noopener" aria-label={name}>
                            <Icon width={24} height={24} fill="currentColor" class="text-primary-contrast" />
                        </a>
                    </li>
                )}
            </ol>
        </nav>

        <div
            class="relative z-10 grid min-h-dvh in-[.-show-content]:mb-(--inset)"
        >
            <!-- Background -->
            <div
                class="[grid-area:1/1] p-(--inset) pb-0 select-none pointer-events-none"
                aria-hidden="true"
            >
                <div id="hero-background" class="h-full"></div>
            </div>

            <!-- Foreground -->
            <main
                class="[clip-path:var(--foreground-mask)] [grid-area:1/1] p-(--inset) pb-0 bg-(--theme-content-background) text-(--theme-content-text) overflow-hidden"
            >
                <header
                    class="h-[calc(100dvh-var(--inset))] grid grid-rows-[1fr_280px_auto_1fr] gap-12"
                >
                    <div id="hero-placeholder" class="row-2 col-1"></div>

                    <div
                        id="hero-foreground"
                        class="row-[1/5] col-1"
                        aria-hidden="true"
                    ></div>

                    <div class="row-3 col-1">
                        <h1 class="sr-only">{page.heading}</h1>

                        <h2
                            id="hero-strapline"
                            class="text-center text-7xl leading-tight text-balance"
                        >
                            {page.strapline}
                        </h2>
                    </div>

                    <MouseIcon
                        width={46}
                        height={46}
                        fill="currentColor"
                        class="row-4 col-1 self-center justify-self-center text-current animate-float not-in-[.-show-nav.-show-mouse-hint]:opacity-0 transition-opacity duration-1000"
                    />
                </header>

                <div class="not-in-[.-show-content]:hidden" data-swap="content">
                    <slot />
                </div>
            </main>
        </div>
    </body>
</html>
