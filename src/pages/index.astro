---
import { Picture } from 'astro:assets';
import InlineSvg from '../components/InlineSvg.astro';
import DemoComponent from '../components/index/DemoComponent.astro';
import PlusSignDivider from '../components/PlusSignDivider.astro';
import freehandCircleSvg from '../images/freehand-circle.svg?raw';
import freehandScribbleSvg from '../images/freehand-scribble.svg?raw';
import portrait from '../images/portrait.jpg';
import tldrSvg from '../images/words/tldr.svg?raw';
import DefaultLayout from '../layouts/DefaultLayout.astro';
import { pages } from '../lib/config';
import type { SpinWheelData } from '../scripts/pages/index';

const spinWheelPageData = Object.values(pages)
    .filter((page) => page.route !== pages.home.route)
    .map<SpinWheelData>((page) => ({
        name: page.name,
        route: page.route,
        colour: page.theme.primary,
        colourContrast: page.theme.primaryContrast,
    }));
---

<DefaultLayout pageMeta={pages.home}>
    <section>
        <!--<div class="flex justify-center p-10 mb-10">
            <h2 class="text-center text-4xl leading-tight text-balance">
                Welcome to my corner of the web!<br>
                This website is designed as a showcase my
                <br>There's plenty here to bore
                you, but if you're in a rush...
            </h2>
        </div> -->

        <div class="p-10">
            <div
                class="js-tldr flex flex-col items-center gap-20 rounded-3xl clip-rounded-3xl border-2 border-primary/25 py-20"
            >
                <div
                    class="fixed -z-10 inset-0 mask-plus mask-plus-small bg-primary/10 pointer-events-none"
                ></div>

                <InlineSvg
                    svg={tldrSvg}
                    class="js-tldr-svg x-tldr-svg w-full max-w-1/3 h-auto"
                    aria-hidden="true"
                />

                <figure class="flex flex-col gap-20 items-center">
                    <figcaption
                        class="text-5xl text-balance text-center leading-tight text-primary px-10"
                    >
                        My name is Rob, and I've been doing this sort of stuff
                        for over 20 years. TypeScript is my forte, and I
                        specialise in anything front-end.
                    </figcaption>

                    <div class="grid grid-cols-[1fr_auto_1fr] self-stretch">
                        <div
                            class="mask-circle bg-primary/25 mask-contain mask-repeat-x mask-top-right"
                        ></div>

                        <Picture
                            class="filter-duotone aspect-square object-cover clip-rounded-50 w-[400px]"
                            src={portrait}
                            formats={['avif', 'webp']}
                            alt="A portrait of me"
                        />

                        <div
                            class="mask-circle bg-primary/25 mask-contain mask-repeat-x mask-top-left"
                        ></div>
                    </div>
                </figure>
            </div>
        </div>

        <div class="x-keywords-container -my-14">
            <div
                class="js-keywords x-keywords skew-y-(--skew-angle) flex flex-col items-center py-10 gap-6 text-7xl lowercase whitespace-nowrap text-stroke-primary/50"
            >
                <div class="js-keywords-line relative">
                    <span
                        class="absolute text-transparent text-stroke-1 right-full select-none"
                        >Focus Spacing Perceivable Operable Understandable
                        VoiceOver W3C JAWS NVDA</span
                    >
                    &nbsp;accessibility&nbsp;
                    <span
                        class="absolute text-transparent text-stroke-1 left-full select-none"
                        >WCAG AAA ARIA Dark Mode High Contrast Keyboard
                        Navigation Captions Consistency</span
                    >
                </div>

                <div class="js-keywords-line relative">
                    <span
                        class="absolute text-transparent text-stroke-1 right-full select-none"
                        >Syntax Structure Relationships Context Headings Roles</span
                    >
                    &nbsp;semantics&nbsp;
                    <span
                        class="absolute text-transparent text-stroke-1 left-full select-none"
                        >Metadata Architecture Elements Sections Hierarchy
                        Articles</span
                    >
                </div>

                <div class="js-keywords-line relative">
                    <span
                        class="absolute text-transparent text-stroke-1 right-full select-none"
                        >Wireframes Animation Composition Creativity Photoshop
                        Aesthetics Figma UX</span
                    >
                    &nbsp;design&nbsp;
                    <span
                        class="absolute text-transparent text-stroke-1 left-full select-none"
                        >Branding XD Illustrator Proportion Typography Balance
                        Colour UI Legibility</span
                    >
                </div>

                <div class="js-keywords-line relative">
                    <span
                        class="absolute text-transparent text-stroke-1 right-full select-none"
                        >Astro Automation Logic Integration GitHub Frameworks
                        CSS3 TypeScript Vue</span
                    >
                    &nbsp;development&nbsp;
                    <span
                        class="absolute text-transparent text-stroke-1 left-full select-none"
                        >HTML5 Tailwind PWA Libraries Code APIs C# Debugging
                        State Bootstrap</span
                    >
                </div>
            </div>
        </div>

        <div class="p-10 text-lg">
            <div
                class="flex flex-col items-center gap-10 rounded-3xl clip-rounded-3xl border-2 border-primary/25 p-10"
            >
                <div
                    class="fixed inset-0 -z-10 mask-plus mask-plus-small bg-primary/10 pointer-events-none"
                ></div>

                <PlusSignDivider />

                <!-- biome-ignore format: preserve whitespace -->
                <p
                    class="js-blurb max-w-prose text-2xl text-pretty text-center leading-normal"
                >
                    I've worked on projects for brands such as <span class="js-mark">Virgin Media</span>, <span class="js-mark">Samsung</span>, the <span class="js-mark">NHS</span>, and <span class="js-mark">Coca-Cola</span>, had long-standing relationships with organisations such as the <span class="js-mark">Exeter Chiefs</span>, and I've developed and maintained large scale e-commerce solutions for brands such as <span class="js-mark">Weird Fish</span>, and the <span class="js-mark">Refined Brands Group</span>.            
                </p>

                <!-- biome-ignore format: preserve whitespace -->
                <p
                    class="js-blurb max-w-prose text-2xl text-pretty text-center leading-normal"
                >
                    In a nutshell, I specialise in shaping client-side experiences, combining strong work ethic with historical perspective, and a deep understanding of usability, accessibility and modern web standards.
                </p>

                <PlusSignDivider />
            </div>
        </div>
    </section>

    <section>
        <svg
            xmlns="http://www.w3.org/2000/svg"
            class="svg-filters"
            aria-hidden="true"
            style="display: none"
        >
            <filter id="grain">
                <feTurbulence
                    type="fractalNoise"
                    baseFrequency="0.8"
                    numOctaves="2"
                    stitchTiles="stitch"
                    result="noise"
                />
                <feColorMatrix
                    in="noise"
                    type="saturate"
                    values="0"
                    result="monoNoise"
                />
                <feComponentTransfer in="monoNoise" result="faintNoise">
                    <feFuncA type="linear" slope="0.25" />
                </feComponentTransfer>
                <feBlend
                    in="SourceGraphic"
                    in2="faintNoise"
                    mode="soft-light"
                />
            </filter>
        </svg>

        <div
            class="min-h-dvh p-10 pt-(--safe-area-top) grid grid-rows-[auto] gap-10"
            style="grid-auto-rows: 685px;"
        >
            <h2
                class="max-w-2/3 justify-self-center text-4xl text-pretty text-center"
                >In a nutshell...</h2
            >

            <div class="js-demos relative h-full rounded-3xl overflow-clip">
                <div class="x-demo-silhouette absolute inset-0">
                    <div
                        class="absolute inset-0 grid place-items-center text-9xl text-primary-contrast"
                        >I ❤ the web</div
                    >
                </div>

                <!-- Paint swirls -->
                <DemoComponent
                    class="js-demo-paint text-white"
                    headingClass="mix-blend-difference"
                >
                    <video
                        playsinline
                        loop
                        muted
                        class="absolute inset-0 w-full h-full object-cover"
                    >
                        <source
                            src="./src/videos/paint-swirls.mp4"
                            type="video/mp4"
                        >
                    </video>
                </DemoComponent>

                <!-- Typographic -->
                <DemoComponent
                    class="js-demo-typographic bg-primary text-primary-contrast filter-[url(#grain)]"
                >
                    <template>
                        <span
                            class="absolute whitespace-nowrap px-[inherit] text-transparent text-stroke-2 text-stroke-primary-contrast origin-[bottom_center]"
                        />
                    </template>
                </DemoComponent>

                <!-- Energy -->
                <DemoComponent
                    class="js-demo-energy bg-black text-primary filter-[url(#grain)]"
                    headingClass="x-demo-energy-heading"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="hidden"
                        aria-hidden="true"
                    >
                        <filter id="fuzz-filter">
                            <feTurbulence
                                in="SourceGraphic"
                                result="turbulence"
                                baseFrequency="0"
                                numOctaves="2"
                                seed="1"
                            />
                            <feDisplacementMap
                                in="SourceGraphic"
                                in2="turbulence"
                                scale="0"
                            />
                        </filter>
                    </svg>

                    <canvas class="absolute inset-0 w-full h-full"></canvas>
                </DemoComponent>

                <!-- Hearts -->
                <DemoComponent
                    class="js-demo-hearts bg-[#ffe1f0] text-[#ff0044] filter-[url(#grain)]"
                    headingClass="text-box-trim"
                >
                    <canvas
                        class="absolute inset-0 w-full h-full"
                        style="filter: drop-shadow(10px 10px 20px rgba(0,0,0,0.25)"
                    ></canvas>
                </DemoComponent>
            </div>
        </div>
    </section>

    <section class="flex flex-col items-center gap-10 p-10 mb-32">
        <h2 class="text-7xl text-balance text-center leading-tight text-white">
            Seen enough?
        </h2>

        <div
            class="js-routes grid grid-cols-2 gap-x-20 text-center w-full max-w-5xl"
        >
            <div class="col-span-2 flex flex-col items-center">
                <svg class="js-connections w-full h-[200px]" aria-hidden="true">
                    <circle cx="6" cy="6" r="6" fill="white" />
                    <path
                        stroke="white"
                        stroke-width="2"
                        fill="none"
                        stroke-linecap="round"
                    />
                </svg>
            </div>

            <div class="js-connection-yep relative py-4">
                <InlineSvg
                    svg={freehandCircleSvg}
                    class="js-circle-svg x-circle-svg h-[100px] absolute top-1/2 left-1/2 -translate-1/2"
                    aria-hidden="true"
                />
                <div class="text-4xl">yep</div>
            </div>

            <div class="js-connection-nope relative py-4">
                <InlineSvg
                    svg={freehandScribbleSvg}
                    class="js-scribble-svg x-scribble-svg h-[110px] absolute top-1/2 left-1/2 -translate-1/2"
                    aria-hidden="true"
                />
                <div class="text-4xl">nope</div>
            </div>

            <div class="flex justify-center">
                <svg
                    class="w-[10px] h-[60px]"
                    viewBox="0 0 10 60"
                    aria-hidden="true"
                >
                    <path
                        d="M 5 3 L 5 63"
                        stroke="white"
                        stroke-width="2"
                        fill="none"
                        stroke-linecap="round"
                    />
                </svg>
            </div>

            <div class="flex justify-center">
                <svg
                    class="w-[10px] h-[60px]"
                    viewBox="0 0 10 60"
                    aria-hidden="true"
                >
                    <path
                        d="M 5 3 L 5 63"
                        stroke="white"
                        stroke-width="2"
                        fill="none"
                        stroke-linecap="round"
                    />
                </svg>
            </div>

            <div
                class="text-4xl rounded-2xl border-2 border-primary p-10 flex flex-col gap-5"
                style="box-shadow: 10px 10px; background-image: linear-gradient(45deg, #000000, #00000000);"
            >
                ❤️
                <a
                    href="/contact"
                    class="underline decoration-wavy decoration-from-font underline-offset-4 decoration-primary/25 hover:decoration-primary"
                    data-astro-prefetch
                    data-link-swap
                    >get in touch</a
                >
            </div>

            <div
                class="text-4xl rounded-2xl border-2 border-primary p-10 flex flex-col gap-5"
                style="box-shadow: 10px 10px; background-image: linear-gradient(45deg, #000000, #00000000);"
            >
                🖕🏻
                <a
                    href="/about"
                    class="underline decoration-wavy decoration-from-font underline-offset-4 decoration-primary/25 hover:decoration-primary"
                    data-astro-prefetch
                    data-link-swap
                    >get to know</a
                >
            </div>
        </div>

        <div class="relative self-stretch">
            <div
                class="js-spin x-spin relative"
                data-pages={JSON.stringify(spinWheelPageData)}
            >
                <canvas
                    class="js-spin-particles x-spin-particles absolute inset-0 w-full h-full z-10"
                ></canvas>

                <div
                    class="js-spin-svg-wrapper x-spin-svg-wrapper relative max-w-[1000px] mx-auto z-20"
                >
                    <svg viewBox="0 0 500 250" aria-hidden="true">
                        <defs>
                            <radialGradient id="spinGradient">
                                <stop
                                    offset="0%"
                                    stop-color="#000"
                                    stop-opacity="0.8"
                                />
                                <stop
                                    offset="100%"
                                    stop-color="#000"
                                    stop-opacity="0"
                                />
                            </radialGradient>

                            <path
                                id="spinPath"
                                d="M 250,250
                                m -180,0
                                a 180,180 0 1,1 360,0
                                a 180,180 0 1,1 -360,0"
                            />
                        </defs>

                        <g
                            class="js-slices-group origin-center transform-box-fill"
                        ></g>

                        <foreignObject
                            class="relative"
                            x="90"
                            y="90"
                            width="320"
                            height="320"
                        >
                            <div
                                class="js-final-slice x-final-slice absolute inset-0 rounded-full opacity-0"
                            ></div>
                            <div
                                class="text-(--colour-contrast) absolute inset-0 bottom-1/2 grid place-items-center"
                                ><span class="js-cooper"
                                    >see you there, slick!</span
                                ></div
                            >
                        </foreignObject>

                        <rect
                            class="pointer-events-none"
                            x="150"
                            y="150"
                            width="200"
                            height="200"
                            fill="url(#spinGradient)"
                        />

                        <text class="text-3xl fill-primary">
                            <textPath
                                class="js-spin-text-path-1"
                                href="#spinPath"
                                startOffset="25%"
                                text-anchor="middle"
                            >
                                let chance decide
                            </textPath>

                            <textPath
                                class="js-spin-text-path-2 fill-(--colour) lowercase"
                                href="#spinPath"
                                startOffset="-75%"
                                text-anchor="middle"
                            ></textPath>
                        </text>
                    </svg>
                </div>

                <span class="x-spin-border absolute inset-0 z-30"></span>
            </div>

            <div
                class="absolute bottom-0 left-1/2 translate-y-1/2 -translate-x-1/2"
            >
                <button
                    class="js-btn-spin c-glass-button px-10 py-2 rounded-4xl corner-squircle cursor-pointer text-primary-contrast text-3xl leading-normal"
                    type="button"
                    >f*ck it</button
                >
            </div>
        </div>
    </section>
</DefaultLayout>
