                                                                                                                                                                                                y: 0,
                                                                                                                                                                                                rotation: '0deg',
                                                                                                                                                                                                ease: 'expo.out',
                                                                                                                                                                                                duration: 1,
                                                                                                                                                                                                stagger: 0.05
