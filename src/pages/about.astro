                            class: "[grid-area:1/1] relative z-10 overflow-clip",
                        }}
                />
                <h3
                    class="[grid-area:1/1] relative z-20 mix-blend-exclusion text-transparent text-9xl"
                    style="-webkit-text-stroke: 3px #ff008b;"
                >
                    day one
                </h3>
            </div>

            <div
                class="[grid-area:1/1] grid place-items-center relative z-20 foo"
            >
                <Picture
                    src={chestBurster}
                    formats={['avif', 'webp']}
                    alt="lorem ipsum"
                    pictureAttributes={{
                            class: "relative z-10 [grid-area:1/1]",
                        }}
                />
                <h3
                    class="[grid-area:1/1] relative z-20 text-9xl text-shadow-[0_0_50px_rgb(0_0_0/0.5)]"
                >
                    day one
                </h3>
                <Image
                    class="absolute splatter sf"
                    src={bloodSplatterFore}
                    alt="foo"
                    aria-hidden="true"
                />
                <Image
                    class="absolute splatter sb"
                    src={bloodSplatterBack}
                    alt="foo"
                    aria-hidden="true"
                />
            </div>
        </div>
    </div>

    <div class="p-10 flex justify-center">
        <p
            class="card xp-10 max-w-2/3 text-4xl text-pretty text-center xtext-white   leading-normal "
        >
            The Berlin Wall was still standing, Whitney Houston was #1, and
            Margaret Thatcher was in charge. Even more frightening is that the
            World Wide Web hadn't been invented yet.
        </p>
    </div>

    <!--<div class="p-10">
        <div class="grid grid-cols-9 grid-rows-2">

        </div>
    </div> -->

    <!--<div class="p-10">
        <div class="bar grid">
            <div class="img [grid-area:1/1]"></div>

            <div class="text [grid-area:1/1]">
                <div class="shape"></div>
                <p class="text-xl">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.</p>
            </div>
        </div>
    </div> -->

    <div class="p-10 text-lg">
        <div
            class="tl4 border-2 border-white/10 xbg-primary xtext-primary-contrast flex flex-col items-center gap-10 p-10"
            style="border-radius: 20px; position: relative; clip-path: inset(0 round 20px);"
        >
            <div class="fixed inset-0 pattern-b pointer-events-none"></div>
            <p
                style="letter-spacing: 10px; color: transparent; -webkit-text-stroke: 1px white;"
                class="text-7xl"
            >
                +++
            </p>
            <p
                class="card xp-10 max-w-prose text-2xl text-pretty text-center leading-normal"
            >
                Growing up I was <i>mostly</i> normal. I climbed trees and built
                bases with my friends. I did however have a fascination for
                things like pipework and wiring. Something about the patterns
                and intricacies would really captivate me. Similarly I loved
                colours, often spending hours drawing pages of Christmas lights.
                Okay I was weird.
            </p>
            <p
                class="card xp-10 max-w-prose text-2xl text-pretty text-center leading-normal"
            >
                Eventually home PC's came along, and with the dial-up tone that
                will forever be seared in my memory, came a doorway to a world
                of creativity and experimentation that I immediately fell in
                love with. It's hard to pinpoint the first time I created an
                actual website, but it was likely some kind of abomination
                hosted on Geocities.
            </p>
            <p
                class="card xp-10 max-w-prose text-2xl text-pretty text-center leading-normal"
            >
                I learnt the basics. HTML was simple back then. CSS was around,
                but you still used <code>&lt;font&gt;</code> tags because that's
                what you knew. I read some books, experimented, probably
                plagiarised a whole bunch, too. I can't forget Lissa Explains It
                All either (IYKYK).
            </p>
            <p
                class="card xp-10 max-w-prose text-2xl text-pretty text-center leading-normal"
            >
                Then came Flash, heralding in a revolution in web design and
                giving us some of the most influential websites ever made.
                Agencies like 2Advanced, WA007, North Kingdom, Group 94, and
                Fantasy Interactive all pushed the boundaries of what was
                possible, and for a teenager it was both mesmerising and
                inspirational.
            </p>
            <p
                class="card xp-10 max-w-prose text-2xl text-pretty text-center leading-normal"
            >
                As smartphones superseded PC's and semantics, accessibility and
                SEO became important, we moved towards modern web standards.
                Browsers were still wildly inconsistent, but jQuery held our
                hand through those dark times.
            </p>
            <p
                class="card xp-10 max-w-prose text-2xl text-pretty text-center leading-normal"
            >
                And finally we arrive in the present, with 10,000 node
                dependencies and a 2 minute build time. But it's not all bad.
                Creativity is certainly going through a renaissance, and amazing
