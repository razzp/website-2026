                                                                                                                                                                                                new THREE.MeshStandardMaterial({ color: 0x0f00dd }),
                                                                                                                                                                                            ];

                                                                                                                                                                                            renderer.render(scene, camera);*/

        const canvas = document.querySelector<HTMLCanvasElement>('.bits')!;
        const ctx = canvas.getContext('2d')!;

        const particles = [];

        const MAX_PARTICLES = 50;
        const SPAWN_RATE = 1; // particles created per frame

        function resizeCanvas() {
            const x = document
                .querySelector('.svgoutline')!
                .getBoundingClientRect()!;
            canvas.width = x.width;
            canvas.height = x.height;
        }

        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        function randomColor() {
            const colors = ['#00f9ff', '#ffffff'];

            return colors[Math.floor(Math.random() * colors.length)];
        }

        function createParticle() {
            return {
                x: Math.random() * canvas.width,
                y: Math.random() * canvas.height,
                rotation: Math.random() * Math.PI * 2,
                rotationSpeed: (Math.random() - 0.5) * 0.02,

                size: Math.random() * 10,

                color: randomColor(),

                // random fade duration
                lifetime: 1000 + Math.random() * 3000,

                // start time
                birth: performance.now(),

                // optional movement
                vx: (Math.random() - 0.5) * 0.5,
                vy: (Math.random() - 0.5) * 0.5,

                // different shapes
                shape: Math.random() > 0.5 ? 'square' : 'circle',
            };
        }

        function clear() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
        }

        function addParticles() {
            /*for (let i = 0; i < SPAWN_RATE; i++) {
                                                                                                                                                                                        if (particles.length >= MAX_PARTICLES) {
                                                                                                                                                                                          // remove a random particle rather than the oldest
                                                                                                                                                                                          const index = Math.floor(Math.random() * particles.length);
                                                                                                                                                                                          particles.splice(index, 1);
                                                                                                                                                                                        }

                                                                                                                                                                                        particles.push(createParticle());
                                                                                                                                                                                      }*/

            for (let i = 0; i < MAX_PARTICLES - particles.length; i++) {
                particles.push(createParticle());
            }
        }

        function drawParticle(particle, now) {
            const age = now - particle.birth;
            const progress = age / particle.lifetime;

            // fade out near the end
            const alpha = Math.max(0, 1 - progress);

            if (alpha === 0) {
                particles.splice(particles.indexOf(particle), 1);
                addParticles();
                return;
            }

            particle.x += particle.vx;
            particle.y += particle.vy;
            particle.rotation += particle.rotationSpeed;

            ctx.globalAlpha = alpha;
            ctx.fillStyle = particle.color;

            //const thickness = particle.size / 3;
            const thickness = 2;
            const length = particle.size;

            ctx.save();

            // move origin to particle position
            ctx.translate(particle.x, particle.y);

            // apply random rotation
            ctx.rotate(particle.rotation);

            // draw plus sign centered at origin
            ctx.fillRect(-length / 2, -thickness / 2, length, thickness);

            ctx.fillRect(-thickness / 2, -length / 2, thickness, length);

            ctx.restore();
        }

        let enabled = false;

        function animate(now) {
            if (!enabled) return;
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            addParticles();

            /*particles = particles.filter(particle => {
                                                                                                                                                                                        return now - particle.birth < particle.lifetime;
                                                                                                                                                                                      });*/

            for (const particle of particles) {
                drawParticle(particle, now);
            }

            ctx.globalAlpha = 1;

            requestAnimationFrame(animate);
        }

        //requestAnimationFrame(animate);
    });
</script>

<DefaultLayout pageMeta={pageMeta}>
    <div class="flex flex-col gap-10 px-10 text-lg">
        <div class="grid day-one">
            <div class="[grid-area:1/1] grid place-items-center relative z-10">
