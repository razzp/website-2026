                                                                                                                                                                                            const light = new THREE.DirectionalLight(0x00f9ff, 10);

                                                                                                                                                                                            light.position.set(0, 10, 20);
                                                                                                                                                                                            light.target.position.set(0, 0, 0);

                                                                                                                                                                                            scene.add(light, light.target);

                                                                                                                                                                                            mesh.material = [
