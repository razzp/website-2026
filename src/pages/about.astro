---
import { Image, Picture } from 'astro:assets';
import chestBurster from '../images/chest-burster.jpg';
import bloodSplatterBack from '../images/splatter-back.svg';
import bloodSplatterFront from '../images/splatter-front.svg';
import DefaultLayout from '../layouts/DefaultLayout.astro';
import type { PageMeta } from '../lib/config';

const pageMeta: PageMeta = {
    routeKey: '/about',
    title: 'About Me',
    heading: 'about',
    strapline:
        "I was born in 1988, and the world hasn't really been the same since.",
    theme: {
        primary: '#00f9ff',
        primaryContrast: '#0f00dd',
        contentBackground: '#0f00dd',
        contentText: '#00f9ff',
        meshFace: '#00f9ff',
    },
};

// Day one section.

const dayOneHeading = 'Day one';
const chestBursterRatio = chestBurster.width / chestBurster.height;
const chestBursterAlt =
    'Photo of the Chest Burster from Alien (1979), jokingly signifying my birth';

const bloodSplatters = [
    { image: bloodSplatterFront, hook: 'js-splatter-front' },
    { image: bloodSplatterBack, hook: 'js-splatter-back' },
];

const otherDays = [
    { image: chestBurster, alt: 'Lorem ipsum', caption: 'Day 365' },
    { image: chestBurster, alt: 'Lorem ipsum', caption: 'Interim' },
    { image: chestBurster, alt: 'Lorem ipsum', caption: 'Day {{day}}' },
];
---

<DefaultLayout pageMeta={pageMeta}>
    <section class="js-day-one">
        <div class="grid p-10">
            <!-- Background -->

            <div
                class="[grid-area:1/1] grid place-items-center relative z-10"
                aria-hidden="true"
            >
                <h2
                    class="[grid-area:1/1] relative z-20 text-transparent text-stroke-2 text-stroke-primary text-9xl lowercase"
                >
                    {dayOneHeading}
                </h2>

                <Picture
                    class="filter-duotone"
                    src={chestBurster}
                    formats={['avif', 'webp']}
                    loading="eager"
                    fetchpriority="high"
                    alt={chestBursterAlt}
                    pictureAttributes={{
                        style: `aspect-ratio:${chestBursterRatio};--parallax:150px;`,
                        class: "x-parallax [grid-area:1/1] relative z-10 w-full overflow-clip",
                    }}
                />
            </div>

            <!-- Foreground -->

            <div
                class="x-hero js-hero [grid-area:1/1] grid place-items-center relative z-20"
            >
                <h2
                    class="js-hero-heading [grid-area:1/1] relative z-20 text-9xl text-shadow-[0_0_50px_rgb(0_0_0/0.5)] lowercase"
                >
                    {dayOneHeading}
                </h2>

                <Picture
                    src={chestBurster}
                    formats={['avif', 'webp']}
                    loading="eager"
                    fetchpriority="high"
                    alt={chestBursterAlt}
                    pictureAttributes={{
                        style: `aspect-ratio:${chestBursterRatio};--parallax:150px;`,
                        class: "x-parallax [grid-area:1/1] relative z-10 w-full",
                    }}
                />

                {bloodSplatters.map(({image, hook}) => (
                    <Image
                        class={`${hook} absolute z-30 -bottom-[20px] left-[20%] w-1/2 mix-blend-multiply origin-[center_bottom] select-none pointer-events-none`}
                        src={image}
                        loading="eager"
                        fetchpriority="high"
                        alt="Blood splatter"
                        aria-hidden="true"
                    />
                ))}
            </div>
        </div>

        <div class="p-10 flex justify-center">
            <p
                class="max-w-2/3 text-4xl text-pretty text-center leading-normal "
            >
                The Berlin Wall was still standing, Whitney Houston was #1, and
                Margaret Thatcher was in charge. Even more frightening is that
                the World Wide Web hadn't been invented yet.
            </p>
        </div>
    </section>

    <section class="p-10 text-lg">
        <div
            class="flex flex-col items-center gap-10 p-10 rounded-3xl clip-rounded-3xl border-2 border-primary/25"
        >
            <div
                class="fixed -z-10 inset-0 mask-plus mask-size-[64px] bg-primary/10 pointer-events-none"
            ></div>

            <p
                class="text-7xl tracking-widest text-transparent text-stroke-1 text-stroke-primary"
            >
                +++
            </p>

            <h2 class="text-4xl">My story</h2>

            <p
                class="max-w-prose text-2xl text-pretty text-center leading-normal"
            >
                Growing up I was <i>mostly</i> normal. I climbed trees and built
                bases with my friends. I did however have a fascination for
                things like pipework and wiring. Something about the patterns
                and intricacies would really captivate me. Similarly I loved
                colours, often spending hours drawing pages of Christmas lights.
                Okay I was weird.
            </p>

            <p
                class="max-w-prose text-2xl text-pretty text-center leading-normal"
            >
                Eventually home PC's came along, and with the dial-up tone that
                will forever be seared in my memory, came a doorway to a world
                of creativity and experimentation that I immediately fell in
                love with. It's hard to pinpoint the first time I created an
                actual website, but it was likely some kind of abomination
                hosted on Geocities.
            </p>

            <p
                class="max-w-prose text-2xl text-pretty text-center leading-normal"
            >
                I learnt the basics. HTML was simple back then. CSS was around,
                but you still used <code>&lt;font&gt;</code> tags because that's
                what you knew. I read some books, experimented, probably
                plagiarised a whole bunch, too. I can't forget Lissa Explains It
                All either (IYKYK).
            </p>

            <p
                class="max-w-prose text-2xl text-pretty text-center leading-normal"
            >
                Then came Flash, heralding in a revolution in web design and
                giving us some of the most influential websites ever made.
                Agencies like 2Advanced, WA007, North Kingdom, Group 94, and
                Fantasy Interactive all pushed the boundaries of what was
                possible, and for a teenager it was both mesmerising and
                inspirational.
            </p>

            <p
                class="max-w-prose text-2xl text-pretty text-center leading-normal"
            >
                As smartphones superseded PC's and semantics, accessibility and
                SEO became important, we moved towards modern web standards.
                Browsers were still wildly inconsistent, but jQuery held our
                hand through those dark times.
            </p>

            <p
                class="max-w-prose text-2xl text-pretty text-center leading-normal"
            >
                And finally we arrive in the present, with 10,000 node
                dependencies and a 2 minute build time. But it's not all bad.
                Creativity is certainly going through a renaissance, and amazing
                tools like Vue, Astro and Tailwind, abstract away time consuming
                tasks, and make development genuinely fun again.
            </p>

            <p
                class="max-w-prose text-2xl text-pretty text-center leading-normal"
            >
                I've seen it all, and I'm glad. I think some historical
                perspective goes a long way, and while I love and use AI daily
                to enhance my workflow and learn new things, I'm also proud of
                my deep knowledge and understanding of the web.
            </p>

            <div class="grid grid-cols-3 gap-10 text-center text-4xl">
                {otherDays.map(day => (
                    <figure class="grid gap-4">
                        <Picture
                            src={day.image}
                            formats={['avif', 'webp']}
                            alt={day.alt}
                            class="filter-duotone aspect-square object-cover clip-ellipse"
                            pictureAttributes={{
                                class: "relative z-10 [grid-area:1/1]",
                            }}
                            aria-hidden="true"
                        />

                        <Picture
                            src={day.image}
                            formats={['avif', 'webp']}
                            alt={day.alt}
                            class="aspect-square object-cover rounded-full opacity-0 hover:opacity-100 transition-opacity"
                            pictureAttributes={{
                                class: "relative z-20 [grid-area:1/1]",
                            }}
                        />

                        <figcaption>{day.caption}</figcaption>
                    </figure>
                ))}
            </div>

            <p
                class="text-7xl tracking-widest text-transparent text-stroke-1 text-stroke-primary"
            >
                +++
            </p>
        </div>
    </section>

    <section class="py-10 flex flex-col gap-10">
        <div class="px-10 flex flex-col items-center gap-10">
            <h2 class="max-w-2/3 text-4xl text-pretty text-center">
                Boring. What do you actually do?
            </h2>

            <p
                class="max-w-prose text-2xl text-pretty text-center leading-normal"
            >
                I build websites and experiences that comply with modern UX
                standards and paradigms. I can take an idea or mock-up, and turn
                it into something...
            </p>
        </div>

        <div
            class="js-awesome x-awesome relative flex items-center justify-center"
        >
            <canvas class="js-awesome-particles x-awesome-particles"></canvas>

            <div class="js-awesome-rays x-awesome-rays clip-ellipse"></div>

            <svg
