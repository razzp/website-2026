---
import { Image, Picture } from 'astro:assets';
import DayThumb from '../components/about/DayThumb.astro';
import NoiseSvg from '../components/about/NoiseSvg.astro';
import InlineSvg from '../components/InlineSvg.astro';
import chestBurster from '../images/chest-burster.jpg';
import holyGrail from '../images/holy-grail.jpg';
import portraitBaby from '../images/portrait-10-months.jpg';
import bloodSplatterBack from '../images/splatter-back.svg';
import bloodSplatterFront from '../images/splatter-front.svg';
import awesomeSvg from '../images/words/awesome.svg?raw';
import DefaultLayout from '../layouts/DefaultLayout.astro';
import type { PageMeta } from '../lib/config';

const pageMeta: PageMeta = {
    routeKey: '/about',
    title: 'About Me',
    heading: 'about',
    strapline:
        "I was born in 1988, and the world hasn't really been the same since.",
    theme: {
        primary: '#00f9ff',
        primaryContrast: '#0f00dd',
        contentBackground: '#0f00dd',
        contentText: '#00f9ff',
        meshFace: '#00f9ff',
    },
};

// Day one section.

const dayOneHeading = 'Day one';
const chestBursterRatio = chestBurster.width / chestBurster.height;
const chestBursterAlt =
    'Photo of the Chest Burster from Alien (1979), jokingly signifying my birth';

const bloodSplatters = [
    { image: bloodSplatterFront, hook: 'js-splatter-front' },
    { image: bloodSplatterBack, hook: 'js-splatter-back' },
];
---

<DefaultLayout pageMeta={pageMeta}>
    <section class="js-day-one">
        <div class="grid p-10">
            <!-- Background -->

            <div
                class="[grid-area:1/1] grid place-items-center relative z-10"
                aria-hidden="true"
            >
                <h2
                    class="[grid-area:1/1] relative z-20 text-transparent text-stroke-2 text-stroke-primary text-9xl lowercase"
                >
                    {dayOneHeading}
                </h2>

                <Picture
                    class="filter-duotone"
                    src={chestBurster}
                    formats={['avif', 'webp']}
                    loading="eager"
                    fetchpriority="high"
                    alt={chestBursterAlt}
                    pictureAttributes={{
                        style: `aspect-ratio:${chestBursterRatio};--parallax:150px;`,
                        class: "x-parallax [grid-area:1/1] relative z-10 w-full overflow-clip",
                    }}
                />
            </div>

            <!-- Foreground -->

            <div
                class="x-hero js-hero [grid-area:1/1] grid place-items-center relative z-20"
            >
                <h2
                    class="js-hero-heading [grid-area:1/1] relative z-20 text-9xl text-shadow-[0_0_50px_rgb(0_0_0/0.5)] lowercase"
                >
                    {dayOneHeading}
                </h2>

                <Picture
                    src={chestBurster}
                    formats={['avif', 'webp']}
                    loading="eager"
                    fetchpriority="high"
                    alt={chestBursterAlt}
                    pictureAttributes={{
                        style: `aspect-ratio:${chestBursterRatio};--parallax:150px;`,
                        class: "x-parallax [grid-area:1/1] relative z-10 w-full",
                    }}
                />

                {bloodSplatters.map(({image, hook}) => (
                    <Image
                        class={`${hook} absolute z-30 bottom-[-20px] left-[20%] w-1/2 mix-blend-multiply origin-[center_bottom] select-none pointer-events-none`}
                        src={image}
                        loading="eager"
                        fetchpriority="high"
                        alt="Blood splatter"
                        aria-hidden="true"
                    />
                ))}
            </div>
        </div>

        <div class="p-10 flex justify-center">
            <p
                class="max-w-2/3 text-4xl text-pretty text-center leading-normal "
            >
                The Berlin Wall was still standing, Whitney Houston was #1, and
                Margaret Thatcher was in charge. Even more frightening is that
                the World Wide Web hadn't been invented yet.
            </p>
        </div>
    </section>

    <section class="p-10 text-lg">
        <div
            class="flex flex-col items-center gap-10 p-10 rounded-3xl clip-rounded-3xl border-2 border-primary/25"
        >
            <div
                class="fixed -z-10 inset-0 mask-plus mask-plus-small bg-primary/10 pointer-events-none"
            ></div>

            <p
                class="text-7xl tracking-widest text-transparent text-stroke-1 text-stroke-primary"
            >
                +++
            </p>

            <h2 class="text-4xl">The story so far</h2>

            <div
                class="max-w-prose flex flex-col gap-10 text-2xl text-pretty text-center leading-normal"
            >
                <!-- biome-ignore format: preserve whitespace -->
                <p>
                    Growing up I was <em>mostly</em> normal. I climbed trees and built bases with my friends. I did however have a fascination for patterns and small intricacies in things. Pipework and circuit boards were of particular interest. Okay, I was weird.
                </p>

                <!-- biome-ignore format: preserve whitespace -->
                <p>
                    Eventually I became acquainted with a dial-up tone, and with it came a doorway into a world of creativity and expression which I immediately fell in love with. It's hard to pinpoint the first time I created a website, but it was undoubtedly hosted on Geocities.
                </p>

                <!-- biome-ignore format: preserve whitespace -->
                <p>
                    I learnt the basics. HTML was simple. CSS was around as well, but it took a while to stop using <code>&lt;font&gt;</code> tags. I read books, joined forums, experimented, probably plagiarised a whole bunch, too. I was like 13 - gimme a break!
                </p>

                <!-- biome-ignore format: preserve whitespace -->
                <p>
                    Then of course came Flash, heralding a revolution in rich media, and giving us some of the most influential websites ever created. Having pixel perfect control, and access to advanced animation features, nurtured the perfectionist in me.
                </p>

                <!-- biome-ignore format: preserve whitespace -->
                <p>
                    As smartphones superseded PC's, and semantics, accessibility and SEO became important, we moved towards modern web standards. Browsers were still wildly inconsistent, but jQuery held our hand through those dark times.
                </p>

                <!-- biome-ignore format: preserve whitespace -->
                <p>
                    And finally we arrive in the present, with 10,000 node dependencies and two minute build times. But it's not all bad. Creativity is certainly going through a renaissance, and both AI and the amazing selection of tools and frameworks we have access to now, abstract away time consuming tasks and make development genuinely fun again.
                </p>

                <!-- biome-ignore format: preserve whitespace -->
                <p>
                    I'm grateful to have seen the web evolve over the years, and for the deep understanding and historical perspective it has given me. I'm excited to see where we go next!
                </p>
            </div>

            <p
                class="text-7xl tracking-widest text-transparent text-stroke-1 text-stroke-primary"
            >
                +++
            </p>

            <div
                class="js-day-thumbs grid grid-cols-3 gap-10 text-center text-4xl"
            >
                <DayThumb
                    image={portraitBaby}
                    alt="Photo of me as a baby, in a pram"
                >
                    Day 320
                </DayThumb>

                <DayThumb image={chestBurster} alt="TODO">
                    Day <span class="js-days-elapsed"></span>
                </DayThumb>

                <DayThumb
                    image={holyGrail}
                    alt="Photo of the fictional character Donovan from the 1989 film Indiana Jones and the Last Crusade, after he drinks from a cup and ages horribly and rapidly"
                >
                    The future
                </DayThumb>
            </div>

            <p
                class="text-7xl tracking-widest text-transparent text-stroke-1 text-stroke-primary"
            >
                +++
            </p>
        </div>
    </section>

    <section
        class="js-boring p-10 pt-[130px] grid grid-rows-[auto_1fr] gap-10 h-dvh"
        style="outline: 1px dotted red;"
    >
        <h2
            class="max-w-2/3 justify-self-center text-4xl text-pretty text-center"
        >
            Boring. What do you actually do?
        </h2>

        <div
            class="js-boring-container grid grid-rows-2 relative bg-primary/5 overflow-clip rounded-4xl"
        >
            <NoiseSvg class="absolute inset-0 z-10" opacity={0.15} />

            <div class="self-center col-1 row-1 z-60">
                <h3
                    class="text-7xl max-w-prose text-balance text-center text-shadow-[10px_10px_80px_#000000]"
                    >lorem ipsum dolor sit amet</h3
                >
            </div>

            <div
                class="x-boring-svg-outer col-1 row-span-full grid grid-rows-subgrid z-20"
            >
                <div class="x-boring-svg-inner self-start relative row-2">
                    <InlineSvg
                        svg={awesomeSvg}
                        class="x-boring-svg js-boring-svg w-2/3 mx-auto h-auto"
                        aria-hidden="true"
                    />
                </div>
            </div>

            <span
                class="x-boring-dot js-boring-dot absolute w-[15px] h-[15px] rounded-full bg-white mix-blend-plus-lighter z-30"
            ></span>

            <div
                class="js-boring-rays x-boring-rays absolute inset-0 z-40 opacity-0"
            ></div>

            <div class="js-boring-three absolute inset-0 z-50 opacity-0"></div>

            <div
                class="js-boring-flash absolute inset-0 bg-white opacity-0 z-70 pointer-events-none"
            ></div>
        </div>
    </section>
</DefaultLayout>
