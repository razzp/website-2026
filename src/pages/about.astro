                                                                                                                                                                                            const camera = new THREE.PerspectiveCamera(75, 1000 / 1000, 0.1, 1000);
                                                                                                                                                                                            const mesh = new THREE.Mesh();

                                                                                                                                                                                            

                                                                                                                                                                                            const pixelsToWorldUnits = (value: number): number => {
                                                                                                                                                                                                const visibleHeight =
                                                                                                                                                                                                    2 *
