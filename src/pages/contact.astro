        <Reason heading="3." body="Something else...">
            <StrokeTrail
                direction="rtl"
                width="2000"
                height="500"
                path="m 2127.7778,87.037037 c -11.8086,62.980903 -40.228,122.770873 -81.6101,171.694923 -41.382,48.92406 -95.6297,86.8674 -155.7793,108.9594 -60.1497,22.09201 -126.0602,28.28083 -189.271,17.77205 -63.2108,-10.50878 -123.5735,-37.69052 -173.3396,-78.056 -34.967,-28.36189 -64.7782,-63.05598 -102.0773,-88.27243 -18.6495,-12.60822 -39.2144,-22.77111 -61.2152,-27.53937 -22.0008,-4.76825 -45.5388,-3.91314 -66.3372,4.70069 -22.2212,9.20308 -40.4228,26.98552 -51.8518,48.14814 -16.7472,31.01014 -18.9828,69.28523 -6.8364,102.36939 12.1464,33.08417 38.2611,60.59501 70.2829,75.31579 32.0218,14.72079 69.5204,16.69955 103.209,6.34705 33.6886,-10.35251 63.3687,-32.77443 83.3445,-61.81 24.302,-35.32389 34.0426,-80.21254 27.255,-122.54801 -6.7877,-42.33548 -29.8817,-81.72504 -63.0697,-108.8714 -33.1879,-27.14635 -76.1096,-41.940045 -118.9852,-41.714451 -42.8755,0.225593 -85.4222,15.338801 -119.2742,41.652381 -33.8539,26.31503 -58.8941,63.06314 -94.4444,87.03703 -45.895,30.95003 -104.9662,37.13908 -159.65129,28.54885 C 913.44138,242.18083 861.92208,220.11406 811.11111,198.14815 692.81198,147.00668 573.86341,95.053397 448.14815,66.666667 252.05818,22.389203 42.84739,38.080012 -144.44444,111.11111"
            />
        </Reason>

        <Reason heading="4." body="Something else..." orientation="right">
            <StrokeTrail
                direction="ltr"
                width="2000"
                height="500"
                path="m -153.7037,46.296296 c 226.620894,52.522209 464.40355,56.336904 692.59259,11.111111 40.26848,-7.980988 81.06755,-17.52135 121.92164,-13.497665 20.42705,2.011842 40.68991,7.510559 58.48734,17.736164 17.79744,10.225605 33.03899,25.353677 41.81324,43.909654 8.387,17.73702 10.61306,38.20127 6.93492,57.4734 -3.67814,19.27213 -13.14735,37.30249 -26.40165,51.76857 -13.25429,14.46608 -30.21213,25.3941 -48.62158,32.17906 -18.40946,6.78497 -38.23812,9.47546 -57.83761,8.57897 -37.65827,-1.72251 -73.34384,-16.30865 -108.63776,-29.55447 -35.29392,-13.24582 -72.32027,-25.51013 -109.88076,-22.29739 -34.72413,2.97013 -68.41616,20.03442 -89.79445,47.55814 -10.68915,13.76187 -18.27237,29.95962 -21.73106,47.03839 -3.45868,17.07876 -2.76306,35.01586 2.26625,51.69977 9.51038,31.54913 34.20672,57.19308 63.49014,72.3019 29.28342,15.10882 62.81816,20.46175 95.76912,20.29069 78.51988,-0.40763 154.25193,-30.94249 221.28322,-71.83679 67.03129,-40.8943 127.02043,-92.14937 189.82789,-139.27432 96.64797,-72.51575 202.07952,-136.248881 318.51852,-168.518517 61.5895,-17.068782 125.2996,-25.076836 188.8889,-31.481482 249.1226,-25.0913802 500.6417,-26.3334497 750,-3.703703"
            />
        </Reason>

        <StrokeTrail
            direction="rtl"
            ease="{'power1.out'}"
            width="1000"
            height="200"
            path="M 1063.8298,145.74468 C 1029.9198,95.872139 975.33951,60.532416 915.95745,50 c -13.33176,-2.364613 -26.88998,-3.53192 -40.42554,-3.191489 -23.73552,0.596968 -47.88434,6.10971 -67.48018,19.516208 -9.79793,6.703248 -18.33816,15.333679 -24.48673,25.48887 -6.14857,10.155191 -9.85873,21.850651 -10.16074,33.718321 -0.38308,15.05316 4.88712,30.24128 14.76934,41.6029 9.88222,11.36161 24.32812,18.71936 39.35432,19.69796 15.02621,0.97861 30.42727,-4.52503 41.20157,-15.04448 10.77431,-10.51945 16.66157,-25.9397 15.31306,-40.93723 -1.35965,-15.12139 -9.91581,-29.22583 -22.07345,-38.319599 -12.15765,-9.093773 -27.64805,-13.302954 -42.82016,-12.744227 -15.85294,0.5838 -31.16893,6.123589 -45.24801,13.433589 -14.07908,7.309997 -27.14356,16.398377 -40.6408,24.733907 -13.49723,8.33554 -27.6244,16.0017 -42.95556,20.07749 -15.33116,4.07579 -32.0842,4.33466 -46.68755,-1.86201 -14.61054,-6.19973 -26.3025,-18.80731 -31.66754,-33.74454 -5.36505,-14.937229 -4.40548,-31.97728 2.33059,-46.348427 6.73608,-14.371147 19.11087,-25.947829 33.78526,-31.994869 14.6744,-6.047041 31.49667,-6.571538 46.61552,-1.741948 17.70423,5.655468 32.90318,18.623013 41.48936,35.106383 9.65985,18.544544 10.80075,41.172236 3.72857,60.849561 -7.07218,19.67732 -22.0999,36.22804 -40.68105,45.81729 -18.58115,9.58926 -40.4985,12.27523 -61.00371,8.18264 -20.5052,-4.0926 -39.5214,-14.82372 -54.17147,-29.74311 -9.55195,-9.72755 -17.23548,-21.09373 -25.64103,-31.82741 C 549.99598,99.992105 540.60435,89.665125 528.7234,82.978723 512.99839,74.128953 494.10825,72.400276 476.16791,74.333767 458.22756,76.267258 440.86367,81.613543 423.40426,86.170213 344.87657,106.66488 262.26891,111.39571 181.91489,100"
        />
    </div>

    <div class="flex flex-col items-center gap-10 p-10">
        <p
            class="js-reason-heading text-[20rem] leading-none [&:not(.-active)]:text-transparent [&:not(.-active)]:text-stroke-2 text-stroke-primary"
        >
            5.
        </p>

        <!-- biome-ignore format: preserve whitespace -->
        <p class="js-counter max-w-2/3 text-4xl text-pretty text-center">
            I <em>did</em> just make you scroll <span class="inline-block"></span> pixels.<br>
        </p>
    </div>

    <div class="text-center tracking-widest text-4xl p-10">❤</div>

    <section class="p-10 mb-20 text-lg">
        <div
            class="flex flex-col items-center gap-10 p-10 rounded-3xl clip-rounded-3xl border-2 border-primary/25"
        >
            <div
                class="fixed -z-10 inset-0 mask-plus mask-size-[64px] bg-primary/10 pointer-events-none"
            ></div>

            <div
                class="self-stretch grid grid-cols-[400px_1fr] gap-10 items-center"
            >
                <div class="relative clip-rounded-50 w-[400px]">
                    <Picture
                        class="filter-duotone aspect-square object-cover"
                        src={portrait}
                        formats={['avif', 'webp']}
                        alt="A portrait of me"
                    />

                    <Image
                        class="thug drop-shadow-2xl/25 drop-shadow-white absolute top-[21%] left-[26%] w-[48%]"
                        src={thugGlasses}
                        alt="Thug life"
                        aria-hidden="true"
                    />
                </div>

                <div class="flex flex-col gap-10 items-start">
                    <div
                        class="inline-flex flex-col items-center gap-10 py-6 px-10 rounded-3xl bg-primary text-primary-contrast"
                    >
                        <h2 class="text-4xl">
                            <a
                                class="hover:underline decoration-wavy decoration-from-font"
                                href={`mailto:${emailAddress}`}
                                >{emailAddress}</a
                            >
                        </h2>
                    </div>

                    <h3 class="text-4xl">
                        I'll even give you some subject ideas!
                    </h3>

                    <ul class="flex flex-wrap gap-4 text-xl">
                        {subjectSuggestions.map(subject => (
                            <li class="flex">
                                <a
                                    class="x-3d-link border-2 border-primary bg-primary-contrast py-2 px-4 rounded-lg"
                                    href={`mailto:${emailAddress}?subject=${encodeURIComponent(subject)}`}
                                    >{subject}</a>
                            </li>
                        ))}
                    </ul>
                </div>
            </div>
        </div>
    </section>
</DefaultLayout>
