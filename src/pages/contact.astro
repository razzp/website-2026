---
import { Image, Picture } from 'astro:assets';
import Reason from '../components/contact/Reason.astro';
import StrokeTrail from '../components/contact/StrokeTrail.astro';
import Plane from '../images/plane.svg';
import portrait from '../images/portrait.jpg';
import thugGlasses from '../images/thug-glasses.svg';
import DefaultLayout from '../layouts/DefaultLayout.astro';
import type { PageMeta } from '../lib/config';

const pageMeta: PageMeta = {
    routeKey: '/contact',
    title: 'Contact',
    heading: 'contact',
    strapline: 'Please get in touch. Especially if you want to hire me!',
    theme: {
        primary: '#fdfe02',
        primaryContrast: '#6a30fe',
        contentBackground: '#6a30fe',
        contentText: '#fdfe02',
        meshFace: '#fdfe02',
    },
};

const emailAddress = 'hello@robertwells.dev';

const subjectSuggestions = [
    'OMG your website is amazing!',
    'Your website is sh*t mate',
    'It would have been better in Flash',
    'I regret clicking this',
    'I bet this was made with AI',
    "I don't know what I want",
    'I want something like this!',
    "I'm sending this out of sympathy",
    'We have a job offer for you!',
];
---

<DefaultLayout pageMeta={pageMeta}>
    <div class="x-plane-bounds">
        <div class="js-plane x-plane">
            <Plane
                class="w-full h-auto"
                style="transform: scaleY(var(--scale-y)) rotate(45deg);"
            />
        </div>
    </div>

    <section class="flex justify-center p-10 text-lg z-50">
        <div
            class="inline-flex flex-col items-center gap-10 py-10 px-12 rounded-3xl bg-primary text-primary-contrast"
        >
            <h2 class="text-7xl">
                <a
                    class="hover:underline decoration-wavy decoration-from-font"
                    href={`mailto:${emailAddress}`}
                    >{emailAddress}</a
                >
            </h2>
        </div>
    </section>

    <div class="p-10 flex flex-col items-center gap-10">
        <h2 class="max-w-2/3 text-4xl text-pretty text-center">
            I'll give you 5 reasons why you should...
        </h2>
    </div>

    <div class="js-trails wrapper">
        <Reason heading="1." body="I'm friendly, fun and professional.">
            <StrokeTrail
                direction="rtl"
                width="2000"
                height="500"
                path="m 2157.4074,268.51852 c -222.6042,31.02629 -443.058,77.47022 -659.2593,138.88889 -31.1817,8.85812 -62.4075,18.05607 -94.51,22.54993 -32.1024,4.49386 -65.3995,4.12678 -96.2307,-5.88327 -26.7573,-8.68735 -51.1645,-24.65108 -69.5634,-45.9325 -18.399,-21.28142 -30.6966,-47.84499 -34.6478,-75.69835 -3.9511,-27.85337 0.5106,-56.8978 12.9758,-82.11763 12.4652,-25.21983 32.9275,-46.47406 57.8312,-59.55951 24.9037,-13.08544 54.1406,-17.87552 81.857,-13.05632 27.7163,4.8192 53.72,19.28227 72.1576,40.53024 18.4376,21.24798 29.113,49.1652 29.1908,77.29731 0.078,28.1321 -10.5206,56.22678 -29.4308,77.05528 -7.6669,8.44462 -16.5868,15.67437 -25.9259,22.22222 -58.3255,40.89345 -133.6926,54.76619 -203.8733,42.56769 C 1127.7979,395.18401 1063.0429,358.06449 1012.963,307.40741 965.51972,259.41736 930.72159,199.84827 881.48148,153.7037 829.92707,105.39032 764.3838,73.806052 696.36202,54.699048 628.34024,35.592043 557.55938,28.391505 487.03704,24.074074 278.59233,11.31293 68.652329,23.14931 -137.03704,59.259259"
            />
        </Reason>

        <Reason heading="2." body="Something else..." orientation="right">
            <StrokeTrail
                direction="ltr"
                width="2000"
                height="500"
                path="m -120.37037,294.44444 c -0.67178,-37.7747 10.27103,-75.67694 30.973187,-107.28074 20.702156,-31.6038 51.077072,-56.77699 85.9749629,-71.25168 34.8978911,-14.4747 74.1728031,-18.190357 111.1660401,-10.51703 36.99324,7.67333 71.55008,26.70355 97.81174,53.86427 26.00578,26.89608 43.39249,60.70691 62.96296,92.59259 43.63763,71.0977 102.05915,136.26309 178.26978,170.19045 38.10532,16.96368 80.18912,25.66018 121.78987,22.63371 C 610.17891,441.64955 651.1968,426.58995 683.33333,400 727.08397,363.80047 752.37268,306.55465 750.36789,249.80516 748.36309,193.05567 719.33832,137.99177 674.07407,103.7037 648.05425,83.993457 616.85033,70.930659 584.39724,67.420483 c -32.4531,-3.510175 -66.06791,2.704908 -94.55927,18.634977 -28.49136,15.93007 -51.59839,41.66501 -63.29289,72.14063 -11.69451,30.47562 -11.63447,65.50827 1.2327,95.50761 10.92402,25.46896 30.64975,46.76441 54.30019,61.20945 23.65044,14.44503 51.075,22.21349 78.71629,24.20382 C 616.07684,343.09762 670.66404,324.52119 720.37037,300 782.02838,269.58279 838.55146,229.90814 896.2963,192.59259 1016.759,114.74787 1147.9734,45.213228 1290.7407,31.481481 c 99.8631,-9.605108 199.9995,8.617277 300,16.666667 186.8222,15.037963 376.4693,-5.823215 555.5556,-61.111111"
